{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/generate.py": {
      "maxDuration": 60
    },
    "api/compile.js": {
      "maxDuration": 60
    },
    "api/auth.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth"
    },
    {
      "src": "/health/llm",
      "dest": "/api/generate"
    },
    {
      "src": "/api/health/llm",
      "dest": "/api/generate"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
