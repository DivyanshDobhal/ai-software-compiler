{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/generate.py": {
      "maxDuration": 60
    },
    "api/compile.js": {
      "maxDuration": 60
    },
    "api/auth.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth"
    },
    {
      "source": "/health/llm",
      "destination": "/api/generate"
    },
    {
      "source": "/api/health/llm",
      "destination": "/api/generate"
    }
  ]
}
