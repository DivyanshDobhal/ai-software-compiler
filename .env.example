# Set these in the Vercel project dashboard (Settings → Environment Variables).
APP_URL=https://your-production-domain.vercel.app
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
GEMINI_API_KEY=your-google-gemini-api-key
AUTH_TOKEN_TTL_DAYS=7
OAUTH_STATE_SECRET=long-random-string-for-oauth-csrf-protection

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
